# Copy this file to .env and fill in real values. Never commit .env.
PORT=3000

# PostgreSQL connection
DB_USER=postgres
DB_HOST=localhost
DB_NAME=cloudcover
DB_PASSWORD=change_me
DB_PORT=5432
# On a hosted database, set DB_SSL=true
DB_SSL=false

# Long random string used to sign login tokens.
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change_me

# Login provider for office users: local (username + password) or cognito (AWS Cognito + MFA).
# Customers always use the local mobile-number login. See docs/aws-cognito-setup.md.
AUTH_PROVIDER=local
COGNITO_REGION=ap-southeast-2
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_DOMAIN=
